<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve dist static assets directly if they exist
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Fallback React routes to dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/index.html [L,QSA]
</IfModule>
